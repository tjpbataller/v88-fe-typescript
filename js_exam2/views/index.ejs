<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/style.css">
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
        <script src="/socket.io/socket.io.js" type="text/javascript"></script>
        <script src="/js/action.js" type="text/javascript"></script>
        <title>Exam Chat</title>
    </head>
    <body>
        <div class="container-fluid w-75 py-3">
            <div class="container row">
                <div class="col-9" id="chat-container">
                    <div class="h-100 overflow-auto" id="chats"></div>
                    <form class="input-group mt-2" method="post" id="message-form">
                        <input class="form-control" type="text" id="message">
                        <select class="form-select" id="target">
                            <option value="">Everyone</option>
                            <option value="">Roanna</option>
                            <option value="">Thalia</option>
                        </select>
                    </form>
                </div>
                <div class="col-3">
                    <div class="border border-dark border-3 p-3 h-100" class="members">
                        <p class="text-center">Participants</p>
                        <div id="participants"></div>
                    </div>
                    <button class="btn btn-secondary w-100 mt-2" id="send">Send</button>
                </div> 
            </div> 
        </div>
    </body>
</html>