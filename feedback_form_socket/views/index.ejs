<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="/socket.io/socket.io.js" type="text/javascript"></script>
    <script src="../script.js" type="text/javascript"></script>
    <title>Socket.io Feedback Form</title>
</head>
<body>
    <div class="container w-50 mx-auto my-5">
        <div class="border border-dark border-3 p-3 bg-success text-light" id="message" style="display: none;">
        </div>
        <h1>Feedback Form</h1>
        <form class="row" action="/result" method="post" id="feedback_form">
            <label class="form-label col-12">Your Name(Optional):</label>
            <input class="form-control col-12" type="text" id="name">
            <label class="form-label col-12">Course Title:</label>
            <select class="form-control col-12" id="track">
                <option value=""></option>
                <option value="PHP Track">PHP Track</option>
                <option value="JS Track">JS Track</option>
                <option value="Web Fundamentals">Web Fundamentals</option>
            </select>
            <label class="form-label col-12">Given Number (1-10):</label>
            <input class="form-control w-25" type="number" id="rate" min="1" max="10">
            <label class="form-label col-12">Reason:</label>
            <textarea class="form-control col-12" id="reason" cols="30" rows="10"></textarea>
            <input class="btn btn-primary col-3 ms-auto mt-3" type="submit" value="Submit">
        </form>
    </div>
</body>
</html>